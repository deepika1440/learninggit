function fixNavHrefsForGlobalUsers() {
    var pathname = window.location.pathname;
    var hasCountryPrefix = /^\/[a-z]{2}(\/|$)/i.test(pathname);

    if (!hasCountryPrefix) {
        document.querySelectorAll('header a[href^="/us/"]')
            .forEach(function (a) {
                var href = a.getAttribute('href');

                if (href) {
                    a.setAttribute(
                        'href',
                        href.replace(/^\/us\//i, '/')
                    );
                }
            });
    }
}
